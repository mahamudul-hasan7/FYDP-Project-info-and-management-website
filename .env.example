# Team Random FYDP - Environment Variables Example
# Copy this file to .env.local for local development.
# On Vercel: Add these variables in Project Settings -> Environment Variables.

# Strong random secret key used for signing session tokens and authentication cookies
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=your_super_secure_random_secret_key_here_32_bytes_or_more

# Node Environment (automatically set by Vercel in production)
NODE_ENV=development
